{
  "name": "vernostudio",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "lint": "ultracite check",
    "format": "ultracite fix",
    "typecheck": "turbo run typecheck",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "turbo build --filter=@vernostudio/cli && changeset publish",
    "prepare": "husky",
    "doctor": "bunx react-doctor@latest",
    "registry:build": "turbo run build --filter=@vernostudio/design-system"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "husky": "^9.1.7",
    "mitata": "^1.0.34",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.68.0",
    "react-doctor": "^0.9.3",
    "turbo": "^2.9.16",
    "typescript": "^7",
    "ultracite": "7.9.4"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.12"
}
