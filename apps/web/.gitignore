# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# registry — `shadcn build` writes these from packages/design-system/registry.json
# on every build, so they are an artifact rather than source.
/public/r

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for commiting if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
